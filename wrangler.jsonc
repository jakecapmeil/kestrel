{
  "name": "kestrel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  // Only public/ is served as static files, so config and secrets never are.
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    // /mcp/* is the Kestrel AI connector; /.well-known/* must answer 404 (not the app) so connectors do not start OAuth.
    "run_worker_first": ["/api/*", "/mcp/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kestrel_db",
      "database_id": "56dacee0-a88e-43f0-aca5-3a31e48f6cdd",
      "migrations_dir": "./migrations"
    }
  ],
  // Supabase project values. Both are public by design (the publishable key
  // ships to every browser); sign-in itself is enforced by Supabase.
  "vars": {
    "SUPABASE_URL": "https://nalkviwzobfatwknyeeu.supabase.co",
    "SUPABASE_KEY": "sb_publishable_CGZ55wWJx7lJPMfXF_hqNg_l_fZUv-a",
    // Kestrel AI default: free-tier Gemini calls per user per day.
    "AI_DAILY_LIMIT": "40"
  },
  // Last-resort AI when there is no Gemini key or its quota is used up.
  "ai": {
    "binding": "AI"
  },
  // Hourly watch sync (intervals.icu) for athletes who connected a watch.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Pull-request previews (Workers Builds runs `wrangler preview`): same public Supabase project, a separate
  // D1 database so previews never touch real athlete data. Apply migrations to it with
  // a temporary config that names kestrel_preview (migrations_dir ./migrations) and `wrangler d1 migrations apply DB --remote -c <it>`.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://nalkviwzobfatwknyeeu.supabase.co",
      "SUPABASE_KEY": "sb_publishable_CGZ55wWJx7lJPMfXF_hqNg_l_fZUv-a",
      "AI_DAILY_LIMIT": "40"
    },
    "d1_databases": [
      { "binding": "DB", "database_id": "d7a074d9-2fa0-468e-8539-a4b7c1d0d688" }
    ],
    "ai": { "binding": "AI" }
  },
  "observability": {
    "enabled": true
  }
}
